import { useState } from 'react';
import DesignationMaster from './components/DesignationMaster';
import PartyMaster from './components/PartyMaster';
import BrandMaster from './components/BrandMaster';
import ProductMaster from './components/ProductMaster';
import TankMaster from './components/TankMaster';
import PurchaseOrder from './components/PurchaseOrder';
import PurchaseReceiving from './components/PurchaseReceiving';
import ProductionOrder from './components/ProductionOrder';
import IssualManagement from './components/IssualManagement';
import FinishedGoods from './components/FinishedGoods';
import SalesOrder from './components/SalesOrder';
import SalesDispatch from './components/SalesDispatch';

export default function App() {
  // State to track which module is currently selected
  const [activeTab, setActiveTab] = useState('party');
  // State to handle mobile menu toggling
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);

  // Array of navigation items for easy rendering
const navItems = [
  { id: 'sales', label: 'Sales Orders' },
  { id: 'dispatch', label: 'Sales Dispatch' },
  { id: 'purchase', label: 'Purchase Orders' },
  { id: 'receiving', label: 'Purchase Receiving' },
  { id: 'production', label: 'Production Orders' },
  { id: 'issual', label: 'Issual Management' },
  { id: 'finished', label: 'Finished Goods Receipt' },
  { id: 'party', label: 'Party Master' },
  { id: 'designation', label: 'Designation Master' },
  { id: 'brand', label: 'Brand Master' },
  { id: 'product', label: 'Product Master' },
  { id: 'tank', label: 'Tank Master' },
];
  // Function to render the correct component based on state
const renderContent = () => {
  switch (activeTab) {
    case 'sales': return <SalesOrder />;
    case 'dispatch': return <SalesDispatch />;
    case 'purchase': return <PurchaseOrder />;
    case 'receiving': return <PurchaseReceiving />;
    case 'production': return <ProductionOrder />;
    case 'issual': return <IssualManagement />;
    case 'finished': return <FinishedGoods />;
    case 'party': return <PartyMaster />;
    case 'designation': return <DesignationMaster />;
    case 'brand': return <BrandMaster />;
    case 'product': return <ProductMaster />;
    case 'tank': return <TankMaster />;
    default: return <PurchaseOrder />;
  }
};
  const handleNavClick = (tabId) => {
    setActiveTab(tabId);
    setIsMobileMenuOpen(false); // Auto-close menu on mobile after clicking
  };

  return (
    <div className="dashboard-container">
      
      {/* SIDEBAR NAVIGATION */}
      <aside className="sidebar">
        <div className="sidebar-header">
          Tarwani Soaps ERP
        </div>
        
        {/* Mobile Toggle Button */}
        <button 
          className="mobile-toggle" 
          onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}
        >
          ☰ Menu
        </button>

        {/* Navigation Links */}
        <nav className={`nav-menu ${isMobileMenuOpen ? 'open' : ''}`}>
          {navItems.map((item) => (
            <button
              key={item.id}
              className={`nav-button ${activeTab === item.id ? 'active' : ''}`}
              onClick={() => handleNavClick(item.id)}
            >
              {item.label}
            </button>
          ))}
        </nav>
      </aside>

      {/* DYNAMIC MAIN CONTENT */}
      <main className="main-content">
        {renderContent()}
      </main>

    </div>
  );
}